# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------------------

# Which provider the pipeline talks to: "mistral" (free tier) or "anthropic".
LLM_BACKEND=mistral

# Required for the mistral backend. Free "Experiment" tier: create a key at
# console.mistral.ai (needs phone verification, and opting in to the plan means
# your prompts may be used for training -- fine for public arXiv papers, NOT
# for private documents).
MISTRAL_API_KEY=

# Only needed if LLM_BACKEND=anthropic. Billed separately from a Claude Pro
# subscription -- a Pro plan does NOT fund API calls.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Per-stage models. Routing is cheap and high-volume, so it gets a small model.
# ---------------------------------------------------------------------------
EXTRACTION_MODEL=mistral-medium-latest
ROUTER_MODEL=mistral-small-latest
CYPHER_MODEL=mistral-medium-latest
SUMMARY_MODEL=mistral-medium-latest
ANSWER_MODEL=mistral-medium-latest
JUDGE_MODEL=mistral-medium-latest

# ---------------------------------------------------------------------------
# Throughput. Mistral does not publish free-tier limits and they vary per
# account -- run `python scripts/probe_limits.py` to measure yours.
#
# NOTE: the binding constraint is TOKENS per minute, not requests per second.
# The probe sends tiny requests and will happily report ~1.6 req/s with no
# throttling; real extraction calls carry ~17k tokens each and hit 429 almost
# immediately at that rate. 0.25 (one call every 4s) is what actually sustains
# extraction on the free tier. Raise it for lighter workloads.
# ---------------------------------------------------------------------------
LLM_RPS=0.25
LLM_MAX_ATTEMPTS=6

# Spend ceiling, enforced before each call. Only meaningful on a paid backend.
MAX_EXTRACTION_SPEND_USD=15.0

# ---------------------------------------------------------------------------
# Storage (relative paths resolve against the repo root, not the cwd)
# ---------------------------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# Retrieval tuning. Note the two chunk sizes: small for retrieval precision,
# wide for extraction so cross-paragraph relations survive intact.
# ---------------------------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
EXTRACTION_WINDOW_TOKENS=4000
TOP_K=8
RESOLVER_SIMILARITY_THRESHOLD=0.92
CYPHER_ROW_LIMIT=200

LOG_LEVEL=INFO
